#!/bin/bash
# Diskinfo - Disk usage analyzer with pretty output
# Show disk space usage and find large directories

set -e

DEPTH=1
SORTBY="size"
TOP_N=10

usage() {
    cat << EOF
Diskinfo - Disk Usage Analyzer

USAGE:
    diskinfo [path] [options]

OPTIONS:
    -d, --depth <N>       Directory depth (default: 1)
    -s, --sort <SIZE|COUNT|NAME>  Sort by (default: size)
    -n, --top <N>         Show top N results (default: 10)
    -h, --help            Show help

EXAMPLES:
    diskinfo
    diskinfo /var -d 2
    diskinfo -n 20

EOF
}

path="${1:-.}"
[[ "$path" == "-h" || "$path" == "--help" ]] && usage && exit 0

echo "💾 Disk Usage: $path"
echo "====================="
echo ""

# Overall disk usage
df -h "$path" | tail -1 | awk '{
    printf "Total: %s\n", $2
    printf "Used:  %s (%s)\n", $3, $5
    printf "Avail: %s\n", $4
}'
echo ""

# Top directories by size
echo "📁 Largest directories:"
du -羊 "$path" 2>/dev/null | sort -rh | head -n "$TOP_N" | while read size dir; do
    printf "   %10s  %s\n" "$size" "$dir"
done

# File count
file_count=$(find "$path" -type f 2>/dev/null | wc -l)
dir_count=$(find "$path" -type d 2>/dev/null | wc -l)
echo ""
echo "📊 Statistics:"
echo "   Files: $file_count"
echo "   Directories: $dir_count"
EOF